{
  "registryVersion": 1,
  "emulators": [
    {
      "id": "eden",
      "label": "Eden (Nintendo Switch)",
      "packages": ["dev.eden.eden_emulator.nightly", "dev.eden.eden_emulator"],
      "targets": [
        {
          "id": "eden-saves",
          "label": "Game saves",
          "category": "SAVE",
          "tier": "SHARED",
          "root": "{EXT}/ROMs/switch/saves",
          "include": ["**"],
          "exclude": ["**/*.tmp", "**/cache/**"],
          "recursive": true,
          "maxBytes": 536870912,
          "compress": "deflate",
          "enabledByDefault": true,
          "critical": false,
          "sensitive": false,
          "coupledWith": ["eden-profiles"],
          "grouping": {
            "pattern": "user/save/{account}/{profile}/{game}/**",
            "gameIdKind": "SWITCH_TITLE_ID",
            "profileIdKind": "SWITCH_USER_UUID"
          },
          "note": "Eden's configured save dir on this device, not its default."
        },
        {
          "id": "eden-custom-drop",
          "label": "Custom Complete Fighters Savegame (manual drop)",
          "category": "SAVE",
          "tier": "SHARED",
          "root": "{EXT}/ROMs/switch/Custom Complete Fighters Savegame",
          "include": ["**"],
          "recursive": true,
          "maxBytes": 134217728,
          "enabledByDefault": true,
          "grouping": null,
          "note": "Non-standard drop outside saves/. Whole folder only."
        },
        {
          "id": "eden-profiles",
          "label": "User profiles (profiles.dat)",
          "category": "SAVE",
          "tier": "APP_PRIVATE",
          "pkg": "dev.eden.eden_emulator.nightly",
          "root": "{DATA}/files/nand/system/save",
          "include": ["**"],
          "recursive": true,
          "maxBytes": 16777216,
          "enabledByDefault": true,
          "critical": true,
          "grouping": null,
          "note": "Every save under eden-saves is keyed to a profile UUID stored here. Restoring saves without this leaves them orphaned."
        },
        {
          "id": "eden-keys",
          "label": "Console keys (prod.keys, title.keys)",
          "category": "KEY",
          "tier": "APP_PRIVATE",
          "pkg": "dev.eden.eden_emulator.nightly",
          "root": "{DATA}/files/keys",
          "include": ["*.keys"],
          "recursive": false,
          "maxBytes": 4194304,
          "enabledByDefault": false,
          "sensitive": true,
          "grouping": null,
          "note": "Not save data. Needed for a working restore on a new device. Stored unencrypted in the archive; review before enabling."
        }
      ]
    }
  ]
}
